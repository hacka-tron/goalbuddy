{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/baselabdel-rahman/Coding/goalbuddy/scripts/restart-metro.sh >> /tmp/metro.log 2>&1",
            "timeout": 30,
            "async": true,
            "statusMessage": "Restarting Metro on both emulators..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f || exit 0; echo \"$f\" | grep -qE '/goalbuddy/server/src/' && cd /Users/baselabdel-rahman/Coding/goalbuddy/server && npm test -- --runInBand 2>&1 | tail -5; } 2>/dev/null || true",
            "async": true,
            "statusMessage": "Running server tests..."
          }
        ]
      }
    ]
  }
}
